[group:docker]
name = {{ docker_storage_volume_group }}
devices = {{ docker_storage_device }}

[volume:docker]
group = {{ docker_storage_volume_group }}
volume = docker
size = 100%FREE

[filesystem:docker]
dev = {{ docker_volume_device }}
fstype = xfs
mount = /var/lib/docker
required_by = docker.service containerd.service
user = root
group = root
mode = {{ docker_root_mode }}
